# ===========================================
# Server
# ===========================================
# Use "production" on the live server — "development" returns OTPs in API
# responses and prints them to the public /log page.
NODE_ENV=development
PORT=5000
# Self-ping target for the keep-alive (only runs when NODE_ENV != production)
# SELF_PING_URL=https://api.your-domain.com/health

# ===========================================
# Database (Supabase PostgreSQL) — REQUIRED
# ===========================================
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ===========================================
# Auth — REQUIRED
# ===========================================
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
# Signs attendance QR codes (falls back to JWT_SECRET if unset)
QR_TOKEN_SECRET=your_qr_token_secret_min_32_chars
# Shared secret the admin dashboard sends to protected routes
DASHBOARD_API_KEY=your_dashboard_api_key

# ===========================================
# OTP via MSG91 WhatsApp — REQUIRED (without these OTPs are never sent)
# ===========================================
MSG91_AUTH_KEY=your_msg91_authkey
MSG91_INTEGRATED_NUMBER=91XXXXXXXXXX

# ===========================================
# Cloudinary (image uploads) — REQUIRED
# ===========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===========================================
# CORS — comma-separated allowed origins
# ===========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,exp://localhost:8081
# Production: CORS_ORIGIN=https://dashboard.your-domain.com

# ===========================================
# Optional
# ===========================================
# Reverse geocoding; without it /geocode returns a mock Lucknow address
# GOOGLE_MAPS_API_KEY=
# Enables the one-time admin setup route — leave unset in production
# ADMIN_SETUP_ENABLED=true
